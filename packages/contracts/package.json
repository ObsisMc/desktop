{
  "name": "@ora/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:error-schema": "ts-to-zod src/error.ts src/error.schema.ts",
    "clean:test": "rm -rf .test-dist",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --max-warnings 0",
    "test": "deno run -A ../../scripts/run-with-clean-stderr.mjs \"rm -rf .test-dist && tsc -p tsconfig.json && deno test --no-check -A .test-dist/tests/*.test.js\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "react-diff-view": "3.3.3",
    "ts-to-zod": "5.1.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
